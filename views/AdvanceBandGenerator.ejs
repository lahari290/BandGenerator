<!DOCTYPE html>
<html lang="en">
    <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Band Generator</title>
    <link rel="stylesheet" href="AdvanceBandGenerator.css">
</head>


<body>
<div class="generatorbody">
   <h1>Band Generator</h1>
   <p>Please click the below button to generate Random Band Name!</p>
   <form action="/generate" method="POST">
   <% if(randomBand){ %>
 <button type="submit"><%=randomBand%></button>
   <% }else{ %>
    <button type="submit">Generate</button>
    <%}%>
    </form>
</div>
<div class="footer">
    <%- include("generatorfooter.ejs")%>
</div>
<script src="generatorfooter.ejs" type="text/javascript"></script>
</body>
 </html>